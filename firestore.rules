rules_version = '2';

// Rentlet access rules. Anyone may browse active listings and open requests; only signed-in
// School accounts (verified Google accounts with an email ending in .edu; Northwestern-only until Nov 4) may
// write, and every write is limited to the writer's own documents or conversations.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // any Google account with a verified email (Founder, Nov 9). The student tag is separate: match /verifications.
    function isNU() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    // the Rentlet team: the admin claim functions/src/review.ts gives to emails on the ADMIN_EMAILS list
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // the team took this listing down; its host can't put it back up
    function hiddenByTeam(id) {
      return exists(/databases/$(database)/documents/reviews/$(id))
        && get(/databases/$(database)/documents/reviews/$(id)).data.get('listing', '') == 'hidden';
    }

    function me() {
      return request.auth.uid;
    }

    // timestamps must come from serverTimestamp()
    function isNow(t) {
      return t == request.time;
    }

    function isDate(s) {
      return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // an optional field: absent, or a string of at most n characters
    function optText(d, f, n) {
      return !(f in d) || (d[f] is string && d[f].size() <= n);
    }

    // one of our three campuses, its id and key naming the same one
    function validCampus(d) {
      return (d.campusId == 'nu-evn' && d.campus == 'evanston')
        || (d.campusId == 'nu-chi' && d.campus == 'chicago')
        || (d.campusId == 'chi-dt' && d.campus == 'downtown');
    }

    // ---------- public profiles ----------
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'photoURL', 'nu', 'joinedAt', 'updatedAt', 'bio', 'year'])
        && d.name is string && d.name.size() <= 60
        && optText(d, 'photoURL', 2048)
        && optText(d, 'bio', 500)
        && (!('year' in d) || d.year is int || (d.year is string && d.year.size() <= 20))
        && (!('nu' in d) || d.nu is bool);
    }

    match /users/{uid} {
      // a profile is read one at a time (a host's first name and photo); nobody lists them all
      allow get: if true;
      allow list: if false;
      allow create, update: if isNU() && me() == uid && validProfile(request.resource.data);
      allow delete: if signedIn() && me() == uid;

      // contact details and other private settings: only the owner
      match /private/{doc} {
        allow read, delete: if signedIn() && me() == uid;
        // the verified school email is written only by functions/src/verify.ts
      allow create, update: if signedIn() && me() == uid && doc != 'verification' && (doc != 'contact' ||
          (request.resource.data.keys().hasOnly(['whatsapp', 'email', 'instagram'])
            && request.resource.data.get('whatsapp', '') is string
            && request.resource.data.get('whatsapp', '').matches('^$|^[+][0-9]{8,15}$')
            && request.resource.data.get('instagram', '') is string && request.resource.data.get('instagram', '').size() <= 30
            && request.resource.data.email is string && request.resource.data.email.size() <= 254));
      }
      match /saves/{listingId} {
        allow read, write: if signedIn() && me() == uid;
      }
      // saved requests: users/{uid}/savedRequests/{requestId} = {savedAt}
      match /savedRequests/{requestId} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['savedAt'])
          && request.resource.data.savedAt is timestamp;
      }
    }

    // ---------- listings ----------
    // The shapes the site reads (src/lib/listingView.ts) and src/listings.ts publishListing writes.
    function validListing(d) {
      return d.ownerId is string
        && d.kind in ['sublet', 'takeover']
        && d.campus in ['evanston', 'chicago', 'downtown']
        && validCampus(d)
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && optText(d, 'building', 80)
        && d.price is int && d.price > 0 && d.price <= 20000
        && isDate(d.start) && isDate(d.end) && d.start < d.end
        && d.status in ['active', 'taken', 'hidden']
        && d.code is string && d.code.matches('[1-9][0-9]{7}')
        && d.ownerName is string && d.ownerName.size() <= 60
        && optText(d, 'ownerPhoto', 2048)
        && d.area is string && d.area.size() <= 80
        // 1-20 photo links (the first is the cover) and at most one short caption each
        && d.photos is list && d.photos.size() > 0 && d.photos.size() <= 20
        && d.photos[0] is string && d.photos.join(' ').size() <= 20 * 2048
        && (!('captions' in d) || (d.captions is list && d.captions.size() <= 20 && d.captions.join(' ').size() <= 20 * 60))
        && (!('video' in d) || d.video == null || (d.video is string && d.video.size() <= 2048 && d.video.matches('https://.+')))
        // the post form's answers: a map, and its groups maps too
        && d.form is map
        && (!('f' in d.form) || d.form.f is map)
        && (!('multi' in d.form) || d.form.multi is map)
        && (!('prefs' in d.form) || d.form.prefs is map)
        && (!('amenD' in d.form) || d.form.amenD is map)
        && (!('walk' in d) || d.walk == null || (d.walk is int && d.walk > 0 && d.walk < 1000))
        && (!('near' in d) || (d.near is list && d.near.size() <= 12))
        && (!('location' in d) || d.location == null
          || (d.location is map && d.location.keys().hasOnly(['lat', 'lng'])
            && d.location.lat is number && d.location.lng is number
            && d.location.lat > 41 && d.location.lat < 43 && d.location.lng > -89 && d.location.lng < -87))
        && (!('description' in d) || (d.description is string && d.description.size() <= 4000));
    }

    match /listings/{id} {
      // a missing id reads as empty, so the page can say "not found"
      allow read: if resource == null
        || resource.data.status == 'active'
        || (signedIn() && resource.data.ownerId == me())
        || isAdmin();
      allow create: if isNU()
        && id == request.resource.data.code
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'active'
        && isNow(request.resource.data.createdAt)
        && validListing(request.resource.data);
      allow update: if isNU()
        && resource.data.ownerId == me()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        && !(request.resource.data.status == 'active' && resource.data.status != 'active' && hiddenByTeam(id))
        && validListing(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == me();

      // street address, building and website; the lease-proof note: the host only. src/profile.ts deletes
      // these before the listing itself (this rule reads the listing to know its host).
      match /private/{docId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/listings/$(id)).data.ownerId == me();
        allow read: if isAdmin() && docId == 'proof';
      }
    }

    // ---------- requests (people looking for a place) ----------
    function validRequest(d) {
      return d.ownerId is string
        && d.campus in ['evanston', 'chicago', 'downtown']
        && (!('campusId' in d) || validCampus(d))
        && optText(d, 'ownerName', 60)
        && optText(d, 'ownerPhoto', 2048)
        && optText(d, 'org', 200)
        && isDate(d.start) && isDate(d.end) && d.start < d.end
        && d.budget is int && d.budget > 0 && d.budget <= 20000
        && d.status in ['open', 'closed']
        && (!('note' in d) || (d.note is string && d.note.size() <= 2000));
    }

    match /requests/{id} {
      allow read: if resource.data.status == 'open'
        || (signedIn() && resource.data.ownerId == me());
      // one request per person: its id is the owner's uid
      allow create: if isNU()
        && id == me()
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'open'
        && isNow(request.resource.data.createdAt)
        && validRequest(request.resource.data);
      allow update: if isNU()
        && resource.data.ownerId == me()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validRequest(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == me();
    }

    // ---------- conversations ----------
    // One conversation per (listing, guest): id = listingId + '_' + guestId.
    // a per-person map field (read marks, contact sharing, blocks) may change only at my own key
    function ownOnly(f) {
      return request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys().hasOnly([me()]);
    }

    function convo(cid) {
      return get(/databases/$(database)/documents/conversations/$(cid)).data;
    }

    match /conversations/{cid} {
      allow read: if signedIn() && me() in resource.data.participants;
      // either side may start it: the guest from a listing, or the host from a request
      allow create: if isNU()
        && me() in [request.resource.data.guestId, request.resource.data.hostId]
        && request.resource.data.hostId != request.resource.data.guestId
        && cid == request.resource.data.listingId + '_' + request.resource.data.guestId
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([request.resource.data.guestId, request.resource.data.hostId])
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.hostId;
      // either side can update shared state (last message, read marks, agreement checklist,
      // shared contact) but never who is in it or what it is about
      allow update: if isNU()
        && me() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.guestId == resource.data.guestId
        && ownOnly('read') && ownOnly('share') && ownOnly('blocked')
        && ownOnly('pinned') && ownOnly('muted') && ownOnly('hidden')
        && ownOnly('clearedAt') && ownOnly('lastHidden');
      allow delete: if false;

      match /messages/{mid} {
        function validReply(d) {
          return !('replyTo' in d) || (d.replyTo is map
            && d.replyTo.keys().hasOnly(['id', 'senderId', 'text'])
            && d.replyTo.id is string && d.replyTo.id.size() <= 64
            && d.replyTo.senderId in convo(cid).participants
            && d.replyTo.text is string && d.replyTo.text.size() <= 80);
        }
        function validBody(d) {
          return (d.get('kind', 'text') == 'text'
              && d.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt', 'replyTo'])
              && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
              && validReply(d))
            || (d.get('kind', 'text') == 'image'
              && d.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt', 'imageUrl', 'width', 'height'])
              && d.text == ''
              && d.imageUrl is string && d.imageUrl.size() <= 2000
              && d.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/v0/b/rentlet-nu[.]firebasestorage[.]app/o/chats%2F' + cid + '%2F' + me() + '%2F[^/?#]+[?].*')
              && d.width is int && d.width > 0 && d.width <= 4000
              && d.height is int && d.height > 0 && d.height <= 4000)
            || (d.get('kind', 'text') == 'listing'
              && d.keys().hasOnly(['senderId', 'text', 'kind', 'createdAt', 'listing'])
              && d.text == ''
              && d.listing is map
              && d.listing.keys().hasOnly(['code', 'title', 'price', 'start', 'end', 'area', 'photo'])
              && d.listing.code is string && d.listing.code.matches('[1-9][0-9]{7}')
              && d.listing.title is string && d.listing.title.size() <= 120
              && d.listing.price is int && d.listing.price >= 0 && d.listing.price <= 20000
              && d.listing.start is string && d.listing.start.size() <= 10
              && d.listing.end is string && d.listing.end.size() <= 10
              && d.listing.area is string && d.listing.area.size() <= 80
              && d.listing.photo is string && d.listing.photo.size() <= 2000
              && get(/databases/$(database)/documents/listings/$(d.listing.code)).data.ownerId == me()
              && get(/databases/$(database)/documents/listings/$(d.listing.code)).data.status == 'active');
        }
        allow read: if signedIn() && me() in convo(cid).participants;
        allow create: if isNU()
          && me() in convo(cid).participants
          && request.resource.data.senderId == me()
          && convo(cid).get('blocked', {}).keys().size() == 0
          && isNow(request.resource.data.createdAt)
          && validBody(request.resource.data);
        // (a) recall: the sender's own text message, within 2 minutes; (b) delete for me: hiddenFor at my own key
        allow update: if isNU()
          && me() in convo(cid).participants
          && ((resource.data.senderId == me()
              && resource.data.get('kind', 'text') == 'text'
              && request.time < resource.data.createdAt + duration.value(2, 'm')
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kind', 'text', 'recalledAt'])
              && request.resource.data.kind == 'recalled'
              && request.resource.data.text == ''
              && request.resource.data.recalledAt == request.time)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
              && request.resource.data.hiddenFor.diff(resource.data.get('hiddenFor', {})).affectedKeys().hasOnly([me()])
              && request.resource.data.hiddenFor[me()] == true));
        allow delete: if false;
      }
    }

    // ---------- the team's decisions on a listing (functions/src/review.ts writes them) ----------
    // listing: approved / hidden, lease: verified / returned, each with the reason the host is shown.
    match /reviews/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if false;
    }

    // ---------- the student tag ----------
    // Written only by functions/src/verify.ts (a code sent to a .edu address), so nobody can give it to themselves.
    // Anyone can read one person's yes or no; the email address itself is private.
    match /verifications/{uid} {
      allow get: if true;
      allow list: if false;
      allow delete: if signedIn() && me() == uid;
      allow create, update: if false;
    }

    // ---------- feedback ----------
    // Send feedback, on every page and without signing in. Nobody can read it from the site; the Rentlet team
    // reads it in the Firebase console.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'text', 'email', 'page', 'uid', 'createdAt'])
        && request.resource.data.type in ['bug', 'idea', 'other']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.email is string && request.resource.data.email.size() <= 254
        && request.resource.data.page is string && request.resource.data.page.size() <= 300
        && (request.resource.data.uid == '' || (signedIn() && request.resource.data.uid == me()))
        && isNow(request.resource.data.createdAt);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- reports ----------
    match /reports/{id} {
      allow create: if isNU()
        && request.resource.data.reporterId == me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
