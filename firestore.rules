rules_version = '2';

// Rentlet access rules. Anyone may browse active listings and open requests; only signed-in
// Northwestern accounts (verified @u.northwestern.edu or @northwestern.edu Google accounts) may
// write, and every write is limited to the writer's own documents or conversations.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isNU() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@(u[.])?northwestern[.]edu');
    }

    function me() {
      return request.auth.uid;
    }

    // timestamps must come from serverTimestamp()
    function isNow(t) {
      return t == request.time;
    }

    function isDate(s) {
      return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }

    // ---------- public profiles ----------
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isNU() && me() == uid
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'nu', 'joinedAt', 'updatedAt', 'bio', 'year'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60;
      allow delete: if signedIn() && me() == uid;

      // contact details and other private settings: only the owner
      match /private/{doc} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid && (doc != 'contact' ||
          (request.resource.data.keys().hasOnly(['instagram', 'email'])
            && request.resource.data.instagram is string && request.resource.data.instagram.size() <= 30
            && request.resource.data.email is string && request.resource.data.email.size() <= 254));
      }
      match /saves/{listingId} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // ---------- listings ----------
    function validListing(d) {
      return d.ownerId is string
        && d.kind in ['sublet', 'takeover']
        && d.campus in ['evanston', 'chicago', 'downtown']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.price is int && d.price > 0 && d.price <= 20000
        && isDate(d.start) && isDate(d.end) && d.start < d.end
        && d.status in ['active', 'taken', 'hidden']
        && d.code is string && d.code.matches('[1-9][0-9]{7}')
        && d.ownerName is string && d.ownerName.size() <= 60
        && d.area is string && d.area.size() <= 80
        && d.photos is list && d.photos.size() > 0 && d.photos.size() <= 20
        && (!('walk' in d) || d.walk == null || (d.walk is int && d.walk > 0 && d.walk < 1000))
        && (!('location' in d) || d.location == null
          || (d.location is map && d.location.keys().hasOnly(['lat', 'lng'])
            && d.location.lat is number && d.location.lng is number
            && d.location.lat > 41 && d.location.lat < 43 && d.location.lng > -89 && d.location.lng < -87))
        && (!('description' in d) || (d.description is string && d.description.size() <= 4000));
    }

    match /listings/{id} {
      // a missing id reads as empty, so the page can say "not found"
      allow read: if resource == null
        || resource.data.status == 'active'
        || (signedIn() && resource.data.ownerId == me());
      allow create: if isNU()
        && id == request.resource.data.code
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'active'
        && isNow(request.resource.data.createdAt)
        && validListing(request.resource.data);
      allow update: if isNU()
        && resource.data.ownerId == me()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validListing(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == me();

      // street address, building and website: the host only
      match /private/{docId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/listings/$(id)).data.ownerId == me();
      }
    }

    // ---------- requests (people looking for a place) ----------
    function validRequest(d) {
      return d.ownerId is string
        && d.campus in ['evanston', 'chicago', 'downtown']
        && isDate(d.start) && isDate(d.end) && d.start < d.end
        && d.budget is int && d.budget > 0 && d.budget <= 20000
        && d.status in ['open', 'closed']
        && (!('note' in d) || (d.note is string && d.note.size() <= 2000));
    }

    match /requests/{id} {
      allow read: if resource.data.status == 'open'
        || (signedIn() && resource.data.ownerId == me());
      // one request per person: its id is the owner's uid
      allow create: if isNU()
        && id == me()
        && request.resource.data.ownerId == me()
        && request.resource.data.status == 'open'
        && isNow(request.resource.data.createdAt)
        && validRequest(request.resource.data);
      allow update: if isNU()
        && resource.data.ownerId == me()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && validRequest(request.resource.data);
      allow delete: if signedIn() && resource.data.ownerId == me();
    }

    // ---------- conversations ----------
    // One conversation per (listing, guest): id = listingId + '_' + guestId.
    // a per-person map field (read marks, contact sharing, blocks) may change only at my own key
    function ownOnly(f) {
      return request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys().hasOnly([me()]);
    }

    function convo(cid) {
      return get(/databases/$(database)/documents/conversations/$(cid)).data;
    }

    match /conversations/{cid} {
      allow read: if signedIn() && me() in resource.data.participants;
      // either side may start it: the guest from a listing, or the host from a request
      allow create: if isNU()
        && me() in [request.resource.data.guestId, request.resource.data.hostId]
        && request.resource.data.hostId != request.resource.data.guestId
        && cid == request.resource.data.listingId + '_' + request.resource.data.guestId
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAll([request.resource.data.guestId, request.resource.data.hostId])
        && get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.ownerId == request.resource.data.hostId;
      // either side can update shared state (last message, read marks, agreement checklist,
      // shared contact) but never who is in it or what it is about
      allow update: if isNU()
        && me() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.hostId == resource.data.hostId
        && request.resource.data.guestId == resource.data.guestId
        && ownOnly('read') && ownOnly('share') && ownOnly('blocked');
      allow delete: if false;

      match /messages/{mid} {
        allow read: if signedIn() && me() in convo(cid).participants;
        allow create: if isNU()
          && me() in convo(cid).participants
          && request.resource.data.senderId == me()
          && request.resource.data.get('kind', 'text') == 'text'
          && convo(cid).get('blocked', {}).keys().size() == 0
          && isNow(request.resource.data.createdAt)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // ---------- reports ----------
    match /reports/{id} {
      allow create: if isNU()
        && request.resource.data.reporterId == me()
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 1000;
      allow read, update, delete: if false;
    }
  }
}
