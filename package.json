{
  "name": "rentlet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "firebase emulators:exec --only auth,firestore,storage \"playwright test\"",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "dev:emu": "VITE_USE_EMULATORS=true vite"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "leaflet": "^1.9.4",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "firebase-admin": "^14.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
